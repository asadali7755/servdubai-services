# Copy to .env.local and fill in real values. Never commit real secrets.

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Stripe — AED 50 paid quote-request flow (see components/QuoteCard.tsx,
# app/api/create-checkout-session, app/api/stripe-webhook).
# Get these from the Stripe Dashboard once the account is created.
STRIPE_SECRET_KEY=
# From Dashboard > Developers > Webhooks, after adding an endpoint pointing
# to https://<your-domain>/api/stripe-webhook (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=
