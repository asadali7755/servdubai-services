# servedubai.com (retired, hacked WordPress history)
#
# The homepage and a WHITELIST of exact old URLs move to servedubai.ae;
# everything else gets 410 Gone, so Google drops it and never sees it on .ae.
# Nothing is forwarded by pattern: each whitelisted URL is a real page the
# .com served (Wayback Machine, 2018-2026) and its .ae target was checked
# live (200). Spam never moves: any request with a query string other than
# ad tracking (utm/fbclid/gclid) is 410 (e.g. /?products/...), and hacked
# *.php, /products/, /ctg/, old WordPress files and theme demo posts are not
# on the whitelist. Redirects drop the query string (trailing "?").
# 14 Nov 2026: homepage only. 20 Nov 2026: whitelist added so links to old
# .com pages pass to .ae. Source copy: servedubai-live/hostinger/servedubai.com.htaccess

RewriteEngine On

# Keep SSL renewal working (Let's Encrypt / Hostinger)
RewriteRule ^\.well-known/ - [L]

# Any query string other than ad tracking -> 410 Gone (spam such as /?products/...).
RewriteCond %{QUERY_STRING} !^$
RewriteCond %{QUERY_STRING} !^(utm_[a-z]+|fbclid|gclid)=[^/]*$ [NC]
RewriteRule ^ - [G,L]

# Homepage. Query is dropped.
RewriteRule ^$ https://servedubai.ae/? [R=301,L]

# Whitelisted old URLs -> servedubai.ae (103 rules).
RewriteRule ^about/?$ https://servedubai.ae/about? [R=301,L,NC]
RewriteRule ^about-us/?$ https://servedubai.ae/about? [R=301,L,NC]
